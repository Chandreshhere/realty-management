{
  "project": {
    "name": "EstateFlow",
    "productType": "real-estate engagement and management platform",
    "objective": "Recreate both supplied dashboard references as functional, faithful, responsive web interfaces while replacing sample content with real-estate engagement data.",
    "buildStack": {
      "frontend": "React 18+ with TypeScript",
      "setup": "Vite or Next.js App Router",
      "styles": "Tailwind CSS plus custom CSS where needed for precise spacing",
      "charts": "Recharts",
      "icons": "lucide-react",
      "animations": "CSS transitions; Framer Motion optional",
      "data": "typed local mock data first, replaceable by APIs"
    },
    "brand": {
      "displayName": "EstateFlow",
      "note": "Replace with actual brand name and logo when provided."
    },
    "defaultRoute": "/dashboard/aurex",
    "routes": [
      "/dashboard/aurex",
      "/dashboard/raseltate"
    ],
    "currency": "INR"
  },
  "referenceRules": {
    "sourceReferences": [
      "Image 1: Aurex Living",
      "Image 2: Raseltate/Real Estate Management"
    ],
    "screenshotsAreLayoutReferencesNotProductionBackgrounds": true,
    "sourcePreviewPixels": {
      "width": 736,
      "height": 552
    },
    "target": "Close visual fidelity to each reference at desktop width; keep typography readable rather than literally using screenshot-size text.",
    "preserve": [
      "overall composition",
      "relative placement and scale of building images",
      "negative space",
      "soft monochromatic palette",
      "rounded cards",
      "minimal linework",
      "pill navigation",
      "compact KPI microvisualizations",
      "tiny table rows",
      "subtle visual hierarchy"
    ],
    "doNot": [
      "display whole reference screenshot as one image",
      "mix both reference layouts on the same route",
      "invent replacement buildings",
      "use unsupplied stock property images",
      "add unrelated gradients",
      "change card hierarchy",
      "add thick borders",
      "use giant typography",
      "use default blue dashboard UI"
    ]
  },
  "assetSystem": {
    "sourceDirectory": "public/assets",
    "alternateIfProjectUsesSrcAssets": "src/assets",
    "scanRecursively": true,
    "extensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".avif",
      ".svg"
    ],
    "manifestFile": "src/data/assetManifest.ts",
    "discovery": "Inspect every available image and map them by subject/appearance, not by guessed filenames. Import resolved real file paths through Vite import.meta.glob or explicit imports.",
    "roles": {
      "aurexLargeBuilding": "wide clean modern villa/building photo, used as top-right hero",
      "aurexPropertyCard1": "exterior residential property photo",
      "aurexPropertyCard2": "facade or contemporary home photo",
      "aurexPropertyCard3": "interior living room photo",
      "aurexTableThumbnail1": "small property exterior thumbnail",
      "aurexTableThumbnail2": "second property exterior thumbnail",
      "raseltateLargeBuilding": "wide modern multi-storey white/grey home with landscape; preserve silhouette",
      "avatarImages": "optional supplied agent/person portraits",
      "mapImage": "optional supplied small local map thumbnail",
      "logo": "provided logo if present; otherwise neutral typography only"
    },
    "mapping": {
      "aurexLargeBuilding": null,
      "aurexPropertyCard1": null,
      "aurexPropertyCard2": null,
      "aurexPropertyCard3": null,
      "aurexTableThumbnail1": null,
      "aurexTableThumbnail2": null,
      "raseltateLargeBuilding": null,
      "avatarImages": [],
      "mapImage": null,
      "logo": null
    },
    "rules": [
      "Never assume exact filenames until the directory has been inspected.",
      "Use image object-fit: cover for listing thumbnail/card photographs.",
      "Use object-fit: contain for main exterior building silhouettes when transparent PNGs are provided.",
      "For hero photos without transparency, use image clipping/masking with a matching background rather than recoloring or distorting them.",
      "If an asset is missing, show a restrained neutral placeholder and report which role is unresolved.",
      "Always preserve source image aspect ratios and never stretch or mirror a building just to fit."
    ]
  },
  "designTokens": {
    "shared": {
      "fontFamily": "Inter, Manrope, or provided brand font",
      "fontWeights": [
        400,
        500,
        600,
        700
