      "shadow": "0 10px 35px rgba(0,0,0,0.025)",
      "border": "1px solid rgba(25,25,25,0.035)",
      "transitions": "160ms ease",
      "spacingUnit": "4px",
      "iconLibrary": "Lucide icons at 15–18px stroke 1.6"
    },
    "aurex": {
      "pageBackground": "#F6F4F5",
      "dashboardBackground": "#E9E6E7",
      "cardBackground": "#F6F4F5",
